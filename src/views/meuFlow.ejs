<!-- views/meuFlow.ejs -->
<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FlowUp • Meu Flow</title>

  <link rel="stylesheet" href="/css/menu.css" />
  <link rel="stylesheet" href="/css/meuFlow.css" />
</head>
<body>
  <div class="app">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="brand"><span>FlowUp</span></div>

      <nav class="nav">
        <a href="/menu"><div class="ico i-analytics"></div><span>Mapa Geral</span></a>
        <a href="/planejamento"><div class="ico i-planning"></div><span>Planejamento Mensal</span></a>
        <a href="/agendamento"><div class="ico i-post"></div><span>Agendamento de Postagem</span></a>
        <a href="/calendario"><div class="ico i-calendar"></div><span>Calendário de Postagem</span></a>
        <a href="/gestao"><div class="ico i-manage"></div><span>Gestão de Projetos</span></a>
        <a class="active" href="/meuFlow"><div class="ico i-myflow"></div><span>Meu Flow</span></a>
        <a href="/briefing"><div class="ico i-briefing"></div><span>Briefing</span></a>
        <a href="/equipe"><div class="ico i-team"></div><span>Equipe</span></a>
      </nav>
    </aside>

    <!-- Topbar -->
    <header class="topbar">
      <div class="company">
        <div class="avatar" title="Logo da Empresa"></div>

        <div class="custom-select">
          <div class="select-selected">
            <span>Empresa A</span>
            <div class="select-arrow"></div>
          </div>

          <div class="select-items">
            <div class="select-option" data-value="Empresa A"><div class="option-avatar"></div><span>Empresa A</span></div>
            <div class="select-option" data-value="Empresa B"><div class="option-avatar"></div><span>Empresa B</span></div>
            <div class="select-option" data-value="Empresa C"><div class="option-avatar"></div><span>Empresa C</span></div>
            <div class="select-divider"></div>
            <div class="select-option select-new-company" data-value="new" id="addCompanyBtn">
              <div class="option-avatar new-company-icon"></div>
              <span>Cadastrar empresa nova</span>
            </div>
          </div>
        </div>
      </div>

      <div class="user" id="user-menu-trigger">
        <div>
          <div class="name">Alone Souza</div>
          <div class="role">Profissional</div>
        </div>

        <div class="avatar" title="Seu perfil"></div>

        <div class="user-menu" id="user-menu">
          <div class="user-menu-header">
            <div class="user-menu-avatar"></div>
            <div class="user-menu-info">
              <div class="user-menu-name">Alone Souza</div>
              <div class="user-menu-email">alone.souza@flowup.com</div>
            </div>
          </div>

          <div class="user-menu-divider"></div>

          <a href="/perfil" class="user-menu-item">
            <div class="user-menu-icon i-profile"></div>
            <span>Meu Perfil</span>
          </a>

          <a href="/mensagem" class="user-menu-item">
            <div class="user-menu-icon i-messages"></div>
            <span>Mensagens</span>
            <span class="user-menu-badge">3</span>
          </a>

          <a href="/config" class="user-menu-item">
            <div class="user-menu-icon i-settings"></div>
            <span>Configurações</span>
          </a>

          <div class="user-menu-divider"></div>

          <a href="#" class="user-menu-item">
            <div class="user-menu-icon i-logout"></div>
            <span>Sair</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Conteúdo -->
    <main class="main myflow-main">
      <div class="myflow-shell">
        <section class="myflow-header">
          <div class="myflow-title">
            <h1>Meu Flow</h1>
            <p class="sub">Aqui ficam as tarefas destinadas a você separadas por status</p>
          </div>

          <div class="myflow-actions">
            <div class="search">
              <span class="mini-ico i-search-mini"></span>
              <input id="taskSearch" type="text" placeholder="Buscar tarefa..." />
            </div>

            <select id="priorityFilter" class="slim-select">
              <option value="all">Prioridade (todas)</option>
              <option value="high">Alta</option>
              <option value="medium">Média</option>
              <option value="low">Baixa</option>
            </select>

            <select id="sortBy" class="slim-select">
              <option value="due_asc">Prazo (mais próximo)</option>
              <option value="due_desc">Prazo (mais distante)</option>
              <option value="priority_desc">Prioridade (alta → baixa)</option>
            </select>

            <button class="btn-ghost" id="clearFiltersBtn">Limpar</button>
          </div>
        </section>

        <section class="myflow-lists" id="listsArea"></section>

        <div class="empty" id="emptyState" style="display:none;">
          <div class="empty-ico"></div>
          <h3>Nenhuma tarefa encontrada</h3>
          <p>Tente ajustar os filtros ou limpar a busca</p>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/menu.js"></script>
  <script src="/js/meuFlow.js"></script>
</body>
</html>
